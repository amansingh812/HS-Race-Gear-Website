# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# =================================
# DATABASE CONFIGURATION
# =================================
# MongoDB connection string
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hsracegear?retryWrites=true&w=majority

# =================================
# JWT CONFIGURATION
# =================================
# Secret key for signing JWT access tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Secret key for signing JWT refresh tokens (generate with: openssl rand -base64 32)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# =================================
# NEXTAUTH CONFIGURATION
# =================================
# Secret for NextAuth.js session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here

# Your application URL
# Development:
NEXTAUTH_URL=http://localhost:3000
# Production:
# NEXTAUTH_URL=https://yourdomain.com

# =================================
# GOOGLE OAUTH
# =================================
# Get these from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =================================
# FACEBOOK OAUTH
# =================================
# Get these from: https://developers.facebook.com/
# 1. Create a new app
# 2. Add Facebook Login product
# 3. Configure OAuth redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# =================================
# EMAIL CONFIGURATION (SMTP)
# =================================
# For password reset emails, welcome emails, etc.
# Using Gmail example (you can use any SMTP provider)

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your email address (Gmail requires App Password, not your regular password)
# To create App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com

# Your email password or App Password
SMTP_PASSWORD=your-app-password

# "From" email address for outgoing emails
SMTP_FROM=noreply@hsracegear.com

# =================================
# OPTIONAL: ADDITIONAL SERVICES
# =================================

# Stripe for payments (Phase 3)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 for file uploads (if needed)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Cloudinary for image hosting (alternative to S3)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SendGrid for emails (alternative to SMTP)
# SENDGRID_API_KEY=

# Sentry for error tracking
# SENTRY_DSN=

# =================================
# NOTES
# =================================
# 1. Generate random secrets using: openssl rand -base64 32
# 2. Never commit this file with real values
# 3. Use different values for development and production
# 4. Store production secrets securely (environment variables in hosting platform)
# 5. Rotate secrets periodically for security
